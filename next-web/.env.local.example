# ---------------------------------------------------------------------------
# Pryzmira environment
# Copy to .env.local and fill in what you need. Everything is optional: with no
# model key the app runs in demo mode and the gallery shows curated picks.
# ---------------------------------------------------------------------------

# --- Model providers (at least one for real generation) --------------------
GROQ_API_KEY=
# GROQ_ANALYZE_MODEL=llama-3.3-70b-versatile
# GROQ_GENERATE_MODEL=llama-3.3-70b-versatile
# DASHSCOPE_API_KEY=
# OPENROUTER_API_KEY=

# --- Accounts, storage, and shared quotas ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Trusted origin used for auth redirects (required in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Build gallery live sources --------------------------------------------
# App-only bearer token from the X developer portal.
X_BEARER_TOKEN=
# Optional: raises GitHub search rate limits from 10 to 30 requests/minute.
GITHUB_TOKEN=
# Set to true to rely on curated picks and X only.
PRYZMIRA_DISABLE_GITHUB_FEED=false

# --- Development -----------------------------------------------------------
# true forces demo mode; false disables the automatic fallback when keys are missing.
# PRYZMIRA_DEMO_MODE=
# Allow the local JSON store when NODE_ENV=production (not recommended).
# ALLOW_LOCAL_VOICE_STORAGE=
